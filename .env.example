# Frontend Fabribat
# - Local (npm run dev): copia este archivo como .env.local
# - Portainer: define estas mismas variables en el stack (se usan al construir la imagen)

# URL del backend incluyendo /api/v1 (la que abre el NAVEGADOR). Local: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://192.168.7.126:8000/api/v1

# Client ID de Google OAuth (el mismo GOOGLE_CLIENT_ID del backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
